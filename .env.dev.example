ASC_ENVIRONMENT=dev
ASC_AUTH_ISSUER=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0
ASC_AUTH_JWKS_URI=https://<tenant>.ciamlogin.com/<tenant-id>/discovery/v2.0/keys
ASC_AUTH_CLIENT_ID=<consumer-web-app-client-id>
ASC_AUTH_ORIGIN=https://<dev-app>.azurewebsites.net
# Use plain Uvicorn with --no-access-log; disable automatic tracing agents.
# Raw AI capture is always disabled at startup. See README privacy-safe logging.
ASC_ADAPTER_MODE=live
# Supply actual deployment values outside source control.
ASC_COSMOS_ENDPOINT=
ASC_COSMOS_DATABASE=
ASC_FOUNDRY_PROJECT_ENDPOINT=
ASC_FOUNDRY_ORCHESTRATOR_DEPLOYMENT=orchestrator
ASC_FOUNDRY_RECIPE_NUTRITION_DEPLOYMENT=recipe-nutrition
ASC_FOUNDRY_EXTRACTION_DEPLOYMENT=extraction
