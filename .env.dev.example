ASC_ENVIRONMENT=dev
ASC_AUTH_ISSUER=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0
ASC_AUTH_JWKS_URI=https://<tenant>.ciamlogin.com/<tenant-id>/discovery/v2.0/keys
ASC_AUTH_CLIENT_ID=<consumer-web-app-client-id>
ASC_AUTH_ORIGIN=https://<dev-app>.azurewebsites.net
# Use plain Uvicorn with --no-access-log; disable automatic tracing agents.
# Raw AI capture is always disabled at startup. See README privacy-safe logging.
ASC_ADAPTER_MODE=live
# Supply actual deployment values outside source control.
ASC_COSMOS_ENDPOINT=
ASC_COSMOS_DATABASE=
ASC_COSMOS_OPERATION_TIMEOUT_SECONDS=5
ASC_COSMOS_MAX_ATTEMPTS=3
ASC_COSMOS_PAGE_SIZE=20
# Protected shared App Service setting; never generate at process startup.
# ASC_PAGINATION_KEY=<environment-specific-Fernet-key>
ASC_FOUNDRY_PROJECT_ENDPOINT=
ASC_FOUNDRY_ORCHESTRATOR_DEPLOYMENT=orchestrator
ASC_FOUNDRY_RECIPE_NUTRITION_DEPLOYMENT=recipe-nutrition
ASC_FOUNDRY_EXTRACTION_DEPLOYMENT=extraction

# ASC-24 managed-agent gateway. Supply approved deployed agent names and versions.
# Runtime names are not Entra principal IDs or model deployment names.
# ASC_FOUNDRY_ORCHESTRATOR_AGENT_NAME=<orchestrator-agent-name>
# ASC_FOUNDRY_ORCHESTRATOR_AGENT_VERSION=1
# ASC_FOUNDRY_RECIPE_NUTRITION_AGENT_NAME=<recipe-agent-name>
# ASC_FOUNDRY_RECIPE_NUTRITION_AGENT_VERSION=1
ASC_FOUNDRY_INVOCATION_TIMEOUT_SECONDS=60
# AZURE_CLIENT_ID=<app-user-assigned-managed-identity-client-id>

# Optional ASC-29 settings. Supply reviewed, dedicated resource names.
# These are not required for the scaffold to start.
# ASC_FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
# ASC_FOUNDRY_IQ_SEARCH_ENDPOINT=https://<service>.search.windows.net
# ASC_FOUNDRY_IQ_INDEX_NAME=asc-recipes
# ASC_FOUNDRY_IQ_KNOWLEDGE_SOURCE_NAME=asc-recipes-source
# ASC_FOUNDRY_IQ_KNOWLEDGE_BASE_NAME=asc-recipes-knowledge
# ASC_FOUNDRY_IQ_CONNECTION_NAME=asc-recipes-mcp
