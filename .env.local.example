ASC_ENVIRONMENT=local
ASC_ADAPTER_MODE=local

# Optional signed-token API testing; all four values must be configured together.
# Copy exact issuer and jwks_uri from the approved external tenant metadata.
# Without these settings protected routes reject all requests; there is no local bypass.
# ASC_AUTH_ISSUER=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0
# ASC_AUTH_JWKS_URI=https://<tenant>.ciamlogin.com/<tenant-id>/discovery/v2.0/keys
# ASC_AUTH_CLIENT_ID=<consumer-web-app-client-id>
# ASC_AUTH_ORIGIN=http://localhost:8000
ASC_READINESS_TIMEOUT_SECONDS=2
# Raw AI capture is always disabled at startup. See README privacy-safe logging.
# Set external OTEL/Azure telemetry flags in the process environment, not this file.
