{
  "schemaVersion": 1,
  "description": "Machine-readable route, header, status and validation fixtures for the supplied outline; not an implemented OpenAPI service.",
  "basePath": "/api/v1",
  "schemaFile": "schemas.json",
  "conventions": {
    "authentication": "server-verified Entra External ID",
    "ownership": "server-derived user scope; /userId partition; foreign IDs return 404",
    "mutationSecurity": ["CSRF token", "Origin validation"],
    "resourceEnvelope": "data",
    "collectionEnvelope": ["items", "nextCursor"],
    "problemMediaType": "application/problem+json",
    "httpBodyMaxBytes": 131072,
    "storedRecordMaxBytes": 262144,
    "lengthMeasurement": "Unicode code points after trimming",
    "byteMeasurement": "UTF-8 serialized JSON",
    "pageDefault": 20,
    "pageMaximum": 50,
    "cursorLifetimeHours": 24,
    "cursorBinding": ["authenticated user", "query", "first-page upper bound"],
    "idempotency": "same key and canonical payload returns stored outcome before stale ETag checks; changed payload returns 409; never regenerate on replay",
    "groceryDuplicateKey": ["trimmed Unicode-casefolded name", "exact selected unit including null"],
    "groceryDecrementStep": 1,
    "groceryDecrementAtOrBelowZero": "confirm conditional DELETE; cancel is no mutation"
  },
  "operations": [
    { "method": "GET", "path": "/me", "success": [200], "etag": true },
    { "method": "PUT", "path": "/me/onboarding", "input": "onboardingInput", "success": [200], "ifMatch": true, "etag": true },
    { "method": "PATCH", "path": "/me/preferences", "input": "preferencePatch", "success": [200], "ifMatch": true, "etag": true },
    { "method": "GET", "path": "/groceries", "success": [200], "etag": true, "pagination": false },
    { "method": "POST", "path": "/groceries", "input": "groceryInput", "success": [201], "ifMatch": true, "etag": true },
    { "method": "PATCH", "path": "/groceries/{groceryId}", "input": "groceryPatch", "success": [200], "ifMatch": true, "etag": true },
    { "method": "DELETE", "path": "/groceries/{groceryId}", "success": [204], "ifMatch": true, "body": false },
    { "method": "POST", "path": "/conversations", "success": [201], "idempotencyKey": true },
    { "method": "GET", "path": "/conversations", "success": [200], "pagination": true, "order": ["createdAt DESC", "id DESC"] },
    { "method": "GET", "path": "/conversations/{conversationId}/turns", "success": [200], "pagination": true, "order": ["turnIndex ASC", "id ASC"] },
    { "method": "POST", "path": "/conversations/{conversationId}/turns", "input": "sendInput", "success": [200, 202], "idempotencyKey": true, "pendingReplay": "202 with operation URL and safe retry interval, no new invocation" },
    { "method": "GET", "path": "/conversations/{conversationId}/operations/{operationId}", "success": [200] },
    { "method": "POST", "path": "/recipes", "input": "saveInput", "success": [201], "idempotencyKey": true, "etag": true },
    { "method": "POST", "path": "/recipes/{historyId}/cooked", "success": [200], "idempotencyKey": true, "ifMatch": true, "etag": true },
    { "method": "POST", "path": "/generated-recipes/{generatedRecipeId}/rejections", "input": "reasonInput", "success": [201], "idempotencyKey": true },
    { "method": "POST", "path": "/generated-recipes/{generatedRecipeId}/revisions", "input": "reasonInput", "success": [200, 202], "idempotencyKey": true, "semantics": "new safety-checked turn in source conversation; same occasion lineage and send deadline/replay rules" },
    { "method": "GET", "path": "/recipes", "success": [200], "pagination": true, "order": ["createdAt DESC", "id DESC"], "filters": ["lifecycle", "rating", "awaitingFeedback"], "awaitingFeedback": "cookedAt != null AND rating == null" },
    { "method": "GET", "path": "/recipes/{historyId}", "success": [200], "etag": true },
    { "method": "PUT", "path": "/recipes/{historyId}/feedback", "input": "feedbackInput", "success": [200], "ifMatch": true, "idempotencyKey": true, "etag": true, "precondition": "cookedAt != null" }
  ],
  "health": { "method": "GET", "path": "/health", "authentication": false, "success": 200, "response": { "status": "ok" } },
  "errorCases": [
    { "condition": "malformed JSON or invalid/expired cursor", "status": 400 },
    { "condition": "missing or invalid authentication", "status": 401 },
    { "condition": "forbidden operation", "status": 403 },
    { "condition": "generation before onboarding", "status": 403, "code": "onboarding_required" },
    { "condition": "absent or foreign owned ID", "status": 404 },
    { "condition": "exact grocery duplicate", "status": 409 },
    { "condition": "feedback before cooking", "status": 409 },
    { "condition": "different send active or idempotency payload mismatch", "status": 409 },
    { "condition": "stale If-Match", "status": 412, "code": "revision_conflict" },
    { "condition": "body or serialized record exceeds byte ceiling", "status": 413 },
    { "condition": "invalid quantity/rating, oversized field/array, unsupported safety constraint or invalid page limit", "status": 422 },
    { "condition": "mandatory generation context does not fit", "status": 422, "code": "context_limit_exceeded" },
    { "condition": "missing required If-Match", "status": 428 },
    { "condition": "rate or admission limit", "status": 429 },
    { "condition": "invalid upstream response", "status": 502 },
    { "condition": "dependency unavailable", "status": 503 },
    { "condition": "deadline exceeded", "status": 504 },
    { "condition": "unexpected internal failure", "status": 500 }
  ],
