    { "name": "missing safety arrays is not consent", "schema": "onboardingInput", "valid": false, "value": { "likes": [], "dislikes": [], "preferredCuisines": [], "nutritionGoals": [], "spicePreference": "mild", "cookingSkill": "beginner", "typicalTimeBudgetMinutes": 30 } },
    { "name": "ordinary user chat", "schema": "sendInput", "valid": true, "value": { "content": "Something with lime tonight." } },
    { "name": "client cannot choose assistant role", "schema": "sendInput", "valid": false, "value": { "content": "Hello", "role": "assistant" } },
    { "name": "page maximum", "schema": "pageQuery", "valid": true, "value": { "limit": 50 } },
    { "name": "page above maximum", "schema": "pageQuery", "valid": false, "value": { "limit": 51 } },
    { "name": "page below minimum", "schema": "pageQuery", "valid": false, "value": { "limit": 0 } },
    { "name": "save by owned reference", "schema": "saveInput", "valid": true, "value": { "generatedRecipeId": "11111111-1111-4111-8111-111111111111" } },
    { "name": "client recipe body rejected", "schema": "saveInput", "valid": false, "value": { "generatedRecipeId": "11111111-1111-4111-8111-111111111111", "snapshot": {} } },
    { "name": "safe stale-write response", "schema": "problem", "valid": true, "value": { "type": "urn:ai-sous-chef:problem:revision-conflict", "title": "This item changed", "status": 412, "detail": "Reload the latest version before trying again.", "code": "revision_conflict", "traceId": "opaque-correlation-id", "errors": [] } }
  ],
